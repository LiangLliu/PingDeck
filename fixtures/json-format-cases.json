[
{"name": "key order is document order", "input": "{\"b\":1,\"a\":2}", "json": "{\n  \"b\": 1,\n  \"a\": 2\n}", "yaml": "b: 1\na: 2"},
{"name": "integer-like keys keep order", "input": "{\"2\":1,\"1\":2}", "json": "{\n  \"2\": 1,\n  \"1\": 2\n}", "yaml": "\"2\": 1\n\"1\": 2"},
{"name": "duplicate keys are kept", "input": "{\"a\":1,\"a\":2}", "json": "{\n  \"a\": 1,\n  \"a\": 2\n}", "yaml": "a: 1\na: 2"},
{"name": "number lexemes are verbatim", "input": "[1.10,1e5,12345678901234567890123,-0,0.5E-3]", "json": "[\n  1.10,\n  1e5,\n  12345678901234567890123,\n  -0,\n  0.5E-3\n]", "yaml": "- 1.10\n- 1e5\n- 12345678901234567890123\n- -0\n- 0.5E-3"},
{"name": "unicode escapes stay in JSON and decode in YAML", "input": "{\"k\":\"\\u00e9\",\"e\":\"\\ud83d\\ude00\"}", "json": "{\n  \"k\": \"\\u00e9\",\n  \"e\": \"\\ud83d\\ude00\"\n}", "yaml": "k: \"é\"\ne: \"😀\""},
{"name": "lone surrogate escape survives", "input": "{\"s\":\"\\ud800\"}", "json": "{\n  \"s\": \"\\ud800\"\n}", "yaml": "s: \"\\ud800\""},
{"name": "nested empty containers", "input": "{\"a\":{},\"b\":[],\"c\":[{}],\"d\":{\"e\":[]}}", "json": "{\n  \"a\": {},\n  \"b\": [],\n  \"c\": [\n    {}\n  ],\n  \"d\": {\n    \"e\": []\n  }\n}", "yaml": "a:\n  {}\nb:\n  []\nc:\n  - {}\nd:\n  e:\n    []"},
{"name": "strings are always double quoted in YAML", "input": "[\"true\",\"null\",\"123\",\": \",\"#\",\" lead\",\"trail \",\"\"]", "json": "[\n  \"true\",\n  \"null\",\n  \"123\",\n  \": \",\n  \"#\",\n  \" lead\",\n  \"trail \",\n  \"\"\n]", "yaml": "- \"true\"\n- \"null\"\n- \"123\"\n- \": \"\n- \"#\"\n- \" lead\"\n- \"trail \"\n- \"\""},
{"name": "only identifier-like keys stay bare", "input": "{\"a b\":1,\"1a\":2,\"\":3,\"ok_key-1\":4,\"é\":5,\"a\\\"b\":6,\"x\\ny\":7}", "json": "{\n  \"a b\": 1,\n  \"1a\": 2,\n  \"\": 3,\n  \"ok_key-1\": 4,\n  \"é\": 5,\n  \"a\\\"b\": 6,\n  \"x\\ny\": 7\n}", "yaml": "\"a b\": 1\n\"1a\": 2\n\"\": 3\nok_key-1: 4\n\"é\": 5\n\"a\\\"b\": 6\n\"x\\ny\": 7"},
{"name": "multiline string", "input": "{\"t\":\"line1\\nline2\\ttab\"}", "json": "{\n  \"t\": \"line1\\nline2\\ttab\"\n}", "yaml": "t: \"line1\\nline2\\ttab\""},
{"name": "YAML normalises escapes", "input": "{\"s\":\"\\/slash \\u0041\",\"c\":\"\\u001F\"}", "json": "{\n  \"s\": \"\\/slash \\u0041\",\n  \"c\": \"\\u001F\"\n}", "yaml": "s: \"/slash A\"\nc: \"\\u001f\""},
{"name": "top-level number with whitespace", "input": "  42  ", "json": "42", "yaml": "42"},
{"name": "top-level string", "input": "\"hi\"", "json": "\"hi\"", "yaml": "\"hi\""},
{"name": "top-level string with escape", "input": "\"a\\u0062\"", "json": "\"a\\u0062\"", "yaml": "\"ab\""},
{"name": "top-level null", "input": "null", "json": "null", "yaml": "null"},
{"name": "top-level true", "input": "true", "json": "true", "yaml": "true"},
{"name": "top-level empty array", "input": "[]", "json": "[]", "yaml": "[]"},
{"name": "top-level empty object", "input": "{}", "json": "{}", "yaml": "{}"},
{"name": "nested arrays", "input": "[[1,2],[3]]", "json": "[\n  [\n    1,\n    2\n  ],\n  [\n    3\n  ]\n]", "yaml": "- - 1\n  - 2\n- - 3"},
{"name": "objects inside arrays", "input": "[{\"a\":1,\"b\":[true,null]},{\"c\":{\"d\":\"x\"}}]", "json": "[\n  {\n    \"a\": 1,\n    \"b\": [\n      true,\n      null\n    ]\n  },\n  {\n    \"c\": {\n      \"d\": \"x\"\n    }\n  }\n]", "yaml": "- a: 1\n  b:\n    - true\n    - null\n- c:\n    d: \"x\""},
{"name": "insignificant whitespace is dropped", "input": " \n{ \"a\" : [ 1 , 2 ] }\t", "json": "{\n  \"a\": [\n    1,\n    2\n  ]\n}", "yaml": "a:\n  - 1\n  - 2"},
{"name": "nested mappings", "input": "{\"a\":{\"b\":{\"c\":1}}}", "json": "{\n  \"a\": {\n    \"b\": {\n      \"c\": 1\n    }\n  }\n}", "yaml": "a:\n  b:\n    c: 1"},
{"name": "trailing comma in array", "input": "[1,2,]", "json": null, "yaml": null},
{"name": "trailing comma in object", "input": "{\"a\":1,}", "json": null, "yaml": null},
{"name": "leading zero", "input": "[01]", "json": null, "yaml": null},
{"name": "trailing garbage", "input": "{\"a\":1} x", "json": null, "yaml": null},
{"name": "single quotes", "input": "{'a':1}", "json": null, "yaml": null},
{"name": "empty input", "input": "", "json": null, "yaml": null},
{"name": "whitespace only", "input": "  \n", "json": null, "yaml": null},
{"name": "NaN", "input": "NaN", "json": null, "yaml": null},
{"name": "missing comma", "input": "[1 2]", "json": null, "yaml": null},
{"name": "unterminated string", "input": "\"abc", "json": null, "yaml": null},
{"name": "raw tab inside string", "input": "\"a\tb\"", "json": null, "yaml": null},
{"name": "plus sign", "input": "+1", "json": null, "yaml": null},
{"name": "bare fraction", "input": ".5", "json": null, "yaml": null},
{"name": "trailing dot", "input": "1.", "json": null, "yaml": null},
{"name": "unquoted key", "input": "{a:1}", "json": null, "yaml": null},
{"name": "bad escape", "input": "\"\\x41\"", "json": null, "yaml": null},
{"name": "ambiguous bare words are quoted as keys", "input": "{\"true\":1,\"False\":2,\"YES\":3,\"no\":4,\"On\":5,\"off\":6,\"y\":7,\"N\":8,\"null\":9,\"Null\":10,\"NULL\":11,\"~\":12}", "json": "{\n  \"true\": 1,\n  \"False\": 2,\n  \"YES\": 3,\n  \"no\": 4,\n  \"On\": 5,\n  \"off\": 6,\n  \"y\": 7,\n  \"N\": 8,\n  \"null\": 9,\n  \"Null\": 10,\n  \"NULL\": 11,\n  \"~\": 12\n}", "yaml": "\"true\": 1\n\"False\": 2\n\"YES\": 3\n\"no\": 4\n\"On\": 5\n\"off\": 6\n\"y\": 7\n\"N\": 8\n\"null\": 9\n\"Null\": 10\n\"NULL\": 11\n\"~\": 12"},
{"name": "numeric-looking keys are quoted", "input": "{\"1\":1,\"1.5\":2,\"0x1F\":3,\"1e3\":4,\".inf\":5,\".nan\":6,\"-1\":7}", "json": "{\n  \"1\": 1,\n  \"1.5\": 2,\n  \"0x1F\": 3,\n  \"1e3\": 4,\n  \".inf\": 5,\n  \".nan\": 6,\n  \"-1\": 7\n}", "yaml": "\"1\": 1\n\"1.5\": 2\n\"0x1F\": 3\n\"1e3\": 4\n\".inf\": 5\n\".nan\": 6\n\"-1\": 7"},
{"name": "keys starting with YAML indicators are quoted", "input": "{\"-\":1,\"?\":2,\":\":3,\",\":4,\"[a\":5,\"]\":6,\"{\":7,\"}\":8,\"#c\":9,\"&a\":10,\"*a\":11,\"!t\":12,\"|\":13,\">\":14,\"'q\":15,\"\\\"q\":16,\"%\":17,\"@\":18,\"`\":19}", "json": "{\n  \"-\": 1,\n  \"?\": 2,\n  \":\": 3,\n  \",\": 4,\n  \"[a\": 5,\n  \"]\": 6,\n  \"{\": 7,\n  \"}\": 8,\n  \"#c\": 9,\n  \"&a\": 10,\n  \"*a\": 11,\n  \"!t\": 12,\n  \"|\": 13,\n  \">\": 14,\n  \"'q\": 15,\n  \"\\\"q\": 16,\n  \"%\": 17,\n  \"@\": 18,\n  \"`\": 19\n}", "yaml": "\"-\": 1\n\"?\": 2\n\":\": 3\n\",\": 4\n\"[a\": 5\n\"]\": 6\n\"{\": 7\n\"}\": 8\n\"#c\": 9\n\"&a\": 10\n\"*a\": 11\n\"!t\": 12\n\"|\": 13\n\">\": 14\n\"'q\": 15\n\"\\\"q\": 16\n\"%\": 17\n\"@\": 18\n\"`\": 19"},
{"name": "keys with colon-space, space-hash, blanks and empty are quoted", "input": "{\"a: b\":1,\"a #b\":2,\"\":3,\" lead\":4,\"trail \":5}", "json": "{\n  \"a: b\": 1,\n  \"a #b\": 2,\n  \"\": 3,\n  \" lead\": 4,\n  \"trail \": 5\n}", "yaml": "\"a: b\": 1\n\"a #b\": 2\n\"\": 3\n\" lead\": 4\n\"trail \": 5"},
{"name": "identifier-like keys that are not YAML keywords stay bare", "input": "{\"yeah\":1,\"nope\":2,\"ok\":3,\"nullable\":4,\"yes_no\":5,\"on-call\":6,\"Y1\":7,\"_\":8,\"truely\":9,\"offer\":10}", "json": "{\n  \"yeah\": 1,\n  \"nope\": 2,\n  \"ok\": 3,\n  \"nullable\": 4,\n  \"yes_no\": 5,\n  \"on-call\": 6,\n  \"Y1\": 7,\n  \"_\": 8,\n  \"truely\": 9,\n  \"offer\": 10\n}", "yaml": "yeah: 1\nnope: 2\nok: 3\nnullable: 4\nyes_no: 5\non-call: 6\nY1: 7\n_: 8\ntruely: 9\noffer: 10"},
{"name": "every retypable or indicator-led string scalar is double quoted", "input": "[\"true\",\"False\",\"yes\",\"no\",\"on\",\"off\",\"y\",\"n\",\"null\",\"~\",\"1\",\"1.5\",\"0x1F\",\"1e3\",\".inf\",\".nan\",\"\",\" lead\",\"trail \",\"- a\",\"? a\",\": a\",\", a\",\"[a\",\"]\",\"{a\",\"}\",\"#a\",\"&a\",\"*a\",\"!a\",\"|\",\"> a\",\"'a\",\"\\\"a\",\"%a\",\"@a\",\"`a\",\"a: b\",\"a #b\"]", "json": "[\n  \"true\",\n  \"False\",\n  \"yes\",\n  \"no\",\n  \"on\",\n  \"off\",\n  \"y\",\n  \"n\",\n  \"null\",\n  \"~\",\n  \"1\",\n  \"1.5\",\n  \"0x1F\",\n  \"1e3\",\n  \".inf\",\n  \".nan\",\n  \"\",\n  \" lead\",\n  \"trail \",\n  \"- a\",\n  \"? a\",\n  \": a\",\n  \", a\",\n  \"[a\",\n  \"]\",\n  \"{a\",\n  \"}\",\n  \"#a\",\n  \"&a\",\n  \"*a\",\n  \"!a\",\n  \"|\",\n  \"> a\",\n  \"'a\",\n  \"\\\"a\",\n  \"%a\",\n  \"@a\",\n  \"`a\",\n  \"a: b\",\n  \"a #b\"\n]", "yaml": "- \"true\"\n- \"False\"\n- \"yes\"\n- \"no\"\n- \"on\"\n- \"off\"\n- \"y\"\n- \"n\"\n- \"null\"\n- \"~\"\n- \"1\"\n- \"1.5\"\n- \"0x1F\"\n- \"1e3\"\n- \".inf\"\n- \".nan\"\n- \"\"\n- \" lead\"\n- \"trail \"\n- \"- a\"\n- \"? a\"\n- \": a\"\n- \", a\"\n- \"[a\"\n- \"]\"\n- \"{a\"\n- \"}\"\n- \"#a\"\n- \"&a\"\n- \"*a\"\n- \"!a\"\n- \"|\"\n- \"> a\"\n- \"'a\"\n- \"\\\"a\"\n- \"%a\"\n- \"@a\"\n- \"`a\"\n- \"a: b\"\n- \"a #b\""}
]

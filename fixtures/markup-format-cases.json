[
{"name": "nested elements", "format": "xml", "input": "<root><a><b>t</b></a></root>", "output": "<root>\n  <a>\n    <b>\n      t\n    </b>\n  </a>\n</root>"},
{"name": "siblings and text leaves", "format": "xml", "input": "<list><item>1</item><item>2</item></list>", "output": "<list>\n  <item>\n    1\n  </item>\n  <item>\n    2\n  </item>\n</list>"},
{"name": "self-closing tags do not open a nesting level", "format": "xml", "input": "<a><br/><img src=\"x\"/><c /></a>", "output": "<a>\n  <br/>\n  <img src=\"x\"/>\n  <c />\n</a>"},
{"name": "inline text between tags", "format": "html", "input": "<p>Hello <b>world</b> again</p>", "output": "<p>\n  Hello\n  <b>\n    world\n  </b>\n  again\n</p>"},
{"name": "xml declaration", "format": "xml", "input": "<?xml version=\"1.0\" encoding=\"UTF-8\"?><r><i>1</i></r>", "output": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<r>\n  <i>\n    1\n  </i>\n</r>"},
{"name": "processing instruction is one token", "format": "xml", "input": "<?xml-stylesheet href=\"a.xsl\"?><r/>", "output": "<?xml-stylesheet href=\"a.xsl\"?>\n<r/>"},
{"name": "processing instruction containing a greater-than sign", "format": "html", "input": "<?php if ($a > 1) { echo 1; } ?><p>x</p>", "output": "<?php if ($a > 1) { echo 1; } ?>\n<p>\n  x\n</p>"},
{"name": "unterminated processing instruction runs to the end", "format": "xml", "input": "<a><?pi never closed", "output": "<a>\n  <?pi never closed"},
{"name": "comment", "format": "xml", "input": "<a><!-- note --><b/></a>", "output": "<a>\n  <!-- note -->\n  <b/>\n</a>"},
{"name": "comment containing a greater-than sign stays whole", "format": "xml", "input": "<a><!-- x > y --><b/></a>", "output": "<a>\n  <!-- x > y -->\n  <b/>\n</a>"},
{"name": "comment containing tags stays whole", "format": "xml", "input": "<a><!-- <b>x</b> --><c/></a>", "output": "<a>\n  <!-- <b>x</b> -->\n  <c/>\n</a>"},
{"name": "multi-line comment is kept verbatim", "format": "xml", "input": "<a><!--\n  line1\n    line2\n--><b/></a>", "output": "<a>\n  <!--\n  line1\n    line2\n-->\n  <b/>\n</a>"},
{"name": "unterminated comment runs to the end", "format": "xml", "input": "<a><!-- never closed <b/>", "output": "<a>\n  <!-- never closed <b/>"},
{"name": "CDATA section", "format": "xml", "input": "<a><![CDATA[ 1 < 2 & 3 ]]></a>", "output": "<a>\n  <![CDATA[ 1 < 2 & 3 ]]>\n</a>"},
{"name": "CDATA containing tags stays whole", "format": "xml", "input": "<a><![CDATA[<x>y</x>]]><b/></a>", "output": "<a>\n  <![CDATA[<x>y</x>]]>\n  <b/>\n</a>"},
{"name": "multi-line CDATA is kept verbatim", "format": "xml", "input": "<a><![CDATA[\n  keep\n    this\n]]></a>", "output": "<a>\n  <![CDATA[\n  keep\n    this\n]]>\n</a>"},
{"name": "doctype and html skeleton", "format": "html", "input": "<!DOCTYPE html><html><head><title>T</title></head><body><p>hi</p></body></html>", "output": "<!DOCTYPE html>\n<html>\n  <head>\n    <title>\n      T\n    </title>\n  </head>\n  <body>\n    <p>\n      hi\n    </p>\n  </body>\n</html>"},
{"name": "doctype with quoted identifiers", "format": "html", "input": "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\"><html><body/></html>", "output": "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\n<html>\n  <body/>\n</html>"},
{"name": "doctype with an internal subset", "format": "xml", "input": "<?xml version=\"1.0\"?><!DOCTYPE note [<!ENTITY a \"b > c\"><!ELEMENT note (#PCDATA)>]><note>&a;</note>", "output": "<?xml version=\"1.0\"?>\n<!DOCTYPE note [<!ENTITY a \"b > c\"><!ELEMENT note (#PCDATA)>]>\n<note>\n  &a;\n</note>"},
{"name": "an unknown bang construct is a declaration up to the next greater-than sign", "format": "html", "input": "<p>wow <! not a decl</p><p>next</p>", "output": "<p>\n  wow\n  <! not a decl</p>\n  <p>\n    next\n  </p>"},
{"name": "attribute value containing a greater-than sign (double quotes)", "format": "xml", "input": "<a href=\"x>y\"><b/></a>", "output": "<a href=\"x>y\">\n  <b/>\n</a>"},
{"name": "attribute value containing a greater-than sign (single quotes)", "format": "xml", "input": "<a title='p>q'><b/></a>", "output": "<a title='p>q'>\n  <b/>\n</a>"},
{"name": "both quote styles and an apostrophe inside the other", "format": "xml", "input": "<a href=\"x>y\" title='p>q' alt=\"it's\">t</a>", "output": "<a href=\"x>y\" title='p>q' alt=\"it's\">\n  t\n</a>"},
{"name": "whitespace around the equals sign before a quote", "format": "xml", "input": "<a b = \"x>y\">t</a>", "output": "<a b = \"x>y\">\n  t\n</a>"},
{"name": "attribute without a value and an unquoted value", "format": "html", "input": "<input disabled value=1><p>x</p>", "output": "<input disabled value=1>\n<p>\n  x\n</p>"},
{"name": "a quote that does not follow an equals sign is an ordinary character", "format": "xml", "input": "<a b\"c>t</a><i d=\"e\"/>", "output": "<a b\"c>\n  t\n</a>\n<i d=\"e\"/>"},
{"name": "a quote that is never closed does not swallow the document", "format": "xml", "input": "<a b=\"x>t</a>", "output": "<a b=\"x>\n  t\n</a>"},
{"name": "attribute value spanning lines is kept whole", "format": "xml", "input": "<a title=\"line1\n  line2>\">t</a>", "output": "<a title=\"line1\n  line2>\">\n  t\n</a>"},
{"name": "void elements do not open a nesting level (html)", "format": "html", "input": "<div><br><span>x</span></div>", "output": "<div>\n  <br>\n  <span>\n    x\n  </span>\n</div>"},
{"name": "every html void element is a leaf", "format": "html", "input": "<p><area><base><br><col><embed><hr><img><input><link><meta><param><source><track><wbr></p>", "output": "<p>\n  <area>\n  <base>\n  <br>\n  <col>\n  <embed>\n  <hr>\n  <img>\n  <input>\n  <link>\n  <meta>\n  <param>\n  <source>\n  <track>\n  <wbr>\n</p>"},
{"name": "void element names match case-insensitively", "format": "html", "input": "<DIV><BR><Img src=x></DIV>", "output": "<DIV>\n  <BR>\n  <Img src=x>\n</DIV>"},
{"name": "the same void tags open a level in xml mode", "format": "xml", "input": "<div><br><span>x</span></div>", "output": "<div>\n  <br>\n    <span>\n      x\n    </span>\n  </div>"},
{"name": "end tag of a void element does not unnest (html)", "format": "html", "input": "<div><br></br><p>x</p></div>", "output": "<div>\n  <br>\n  </br>\n  <p>\n    x\n  </p>\n</div>"},
{"name": "script content is kept verbatim", "format": "html", "input": "<html><body><script>if (a < b && c > d) { go(\"</p>\"); }</script><p>x</p></body></html>", "output": "<html>\n  <body>\n    <script>if (a < b && c > d) { go(\"</p>\"); }</script>\n    <p>\n      x\n    </p>\n  </body>\n</html>"},
{"name": "multi-line script keeps its own indentation", "format": "html", "input": "<div><script>\n  function f() {\n    return 1;\n  }\n</script></div>", "output": "<div>\n  <script>\n  function f() {\n    return 1;\n  }\n</script>\n</div>"},
{"name": "script element with attributes and no content", "format": "html", "input": "<head><script type=\"text/javascript\" src=\"a.js\"></script><title>t</title></head>", "output": "<head>\n  <script type=\"text/javascript\" src=\"a.js\"></script>\n  <title>\n    t\n  </title>\n</head>"},
{"name": "style content is kept verbatim", "format": "html", "input": "<head><style>a > b { color: red; }\n  p { margin: 0 }</style></head>", "output": "<head>\n  <style>a > b { color: red; }\n  p { margin: 0 }</style>\n</head>"},
{"name": "pre content is kept verbatim", "format": "html", "input": "<div><pre>  line1\n    line2 <b>bold</b>\n</pre><p>after</p></div>", "output": "<div>\n  <pre>  line1\n    line2 <b>bold</b>\n</pre>\n  <p>\n    after\n  </p>\n</div>"},
{"name": "textarea content is kept verbatim", "format": "html", "input": "<form><textarea name=\"t\">\n  <not a tag>\n</textarea></form>", "output": "<form>\n  <textarea name=\"t\">\n  <not a tag>\n</textarea>\n</form>"},
{"name": "raw-text element names and closers match case-insensitively", "format": "html", "input": "<div><SCRIPT>a < b</Script ><p>x</p></div>", "output": "<div>\n  <SCRIPT>a < b</Script >\n  <p>\n    x\n  </p>\n</div>"},
{"name": "a longer closing tag name does not end a raw-text element", "format": "html", "input": "<div><script>a</scripts>b</script><p>x</p></div>", "output": "<div>\n  <script>a</scripts>b</script>\n  <p>\n    x\n  </p>\n</div>"},
{"name": "unterminated raw-text element keeps the rest verbatim", "format": "html", "input": "<div><script>var a = 1;\n  var b = 2;\n", "output": "<div>\n  <script>var a = 1;\n  var b = 2;"},
{"name": "self-closing script is a leaf", "format": "html", "input": "<div><script/><p>x</p></div>", "output": "<div>\n  <script/>\n  <p>\n    x\n  </p>\n</div>"},
{"name": "script and pre are ordinary elements in xml mode", "format": "xml", "input": "<r><script>a</script><pre>  x\n y</pre></r>", "output": "<r>\n  <script>\n    a\n  </script>\n  <pre>\n    x\n y\n  </pre>\n</r>"},
{"name": "lone less-than followed by a space is text", "format": "html", "input": "<p>1 < 2 and 3 > 2</p>", "output": "<p>\n  1 < 2 and 3 > 2\n</p>"},
{"name": "less-than followed by a digit is text", "format": "html", "input": "<p>x <3 y</p>", "output": "<p>\n  x <3 y\n</p>"},
{"name": "less-than followed by another less-than", "format": "html", "input": "<p>1 <<b>x</b></p>", "output": "<p>\n  1 <\n  <b>\n    x\n  </b>\n</p>"},
{"name": "empty angle brackets are text", "format": "xml", "input": "<a>a<>b</a>", "output": "<a>\n  a<>b\n</a>"},
{"name": "slash that does not start an end tag is text", "format": "html", "input": "<p>x</p></ b><p>y</p>", "output": "<p>\n  x\n</p>\n</ b>\n<p>\n  y\n</p>"},
{"name": "less-than at the very end is text", "format": "html", "input": "<p>x</p> <", "output": "<p>\n  x\n</p>\n<"},
{"name": "unterminated trailing tag is kept as one token", "format": "xml", "input": "<a><b", "output": "<a>\n  <b"},
{"name": "unterminated end tag is kept as one token", "format": "xml", "input": "<a></a", "output": "<a>\n</a"},
{"name": "unclosed elements", "format": "xml", "input": "<a><b>text", "output": "<a>\n  <b>\n    text"},
{"name": "stray closing tag never goes below depth zero", "format": "xml", "input": "</a></b><c>x</c>", "output": "</a>\n</b>\n<c>\n  x\n</c>"},
{"name": "input that is already indented", "format": "xml", "input": "<a>\n  <b>\n    <c/>\n  </b>\n</a>\n", "output": "<a>\n  <b>\n    <c/>\n  </b>\n</a>"},
{"name": "whitespace between tags collapses but inside text stays", "format": "html", "input": "<p>a   b</p>   <p>c\n\nd</p>", "output": "<p>\n  a   b\n</p>\n<p>\n  c\n\nd\n</p>"},
{"name": "non-breaking space between tags is an empty text node and dropped", "format": "xml", "input": "<a><b/> <c/></a>", "output": "<a>\n  <b/>\n  <c/>\n</a>"},
{"name": "a byte order mark between tags is text, not whitespace", "format": "xml", "input": "<a>﻿<b/></a>", "output": "<a>\n  ﻿\n  <b/>\n</a>"},
{"name": "tab and carriage returns between tags collapse", "format": "xml", "input": "<a>\r\n\t<b/>\r\n</a>", "output": "<a>\n  <b/>\n</a>"},
{"name": "unicode names and text", "format": "xml", "input": "<名前 属性=\"値\">太郎 😀</名前>", "output": "<名前 属性=\"値\">\n  太郎 😀\n</名前>"},
{"name": "text only", "format": "html", "input": "just text", "output": "just text"},
{"name": "whitespace only is returned untouched", "format": "xml", "input": "  \n ", "output": "  \n "},
{"name": "empty body", "format": "xml", "input": "", "output": ""},
{"name": "leading and trailing whitespace is trimmed", "format": "xml", "input": "\n  <a><b/></a>  \n", "output": "<a>\n  <b/>\n</a>"},
{"name": "indentation stops growing at 64 levels", "format": "xml", "input": "<a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a><a>x</a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a></a>", "output": "<a>\n  <a>\n    <a>\n      <a>\n        <a>\n          <a>\n            <a>\n              <a>\n                <a>\n                  <a>\n                    <a>\n                      <a>\n                        <a>\n                          <a>\n                            <a>\n                              <a>\n                                <a>\n                                  <a>\n                                    <a>\n                                      <a>\n                                        <a>\n                                          <a>\n                                            <a>\n                                              <a>\n                                                <a>\n                                                  <a>\n                                                    <a>\n                                                      <a>\n                                                        <a>\n                                                          <a>\n                                                            <a>\n                                                              <a>\n                                                                <a>\n                                                                  <a>\n                                                                    <a>\n                                                                      <a>\n                                                                        <a>\n                                                                          <a>\n                                                                            <a>\n                                                                              <a>\n                                                                                <a>\n                                                                                  <a>\n                                                                                    <a>\n                                                                                      <a>\n                                                                                        <a>\n                                                                                          <a>\n                                                                                            <a>\n                                                                                              <a>\n                                                                                                <a>\n                                                                                                  <a>\n                                                                                                    <a>\n                                                                                                      <a>\n                                                                                                        <a>\n                                                                                                          <a>\n                                                                                                            <a>\n                                                                                                              <a>\n                                                                                                                <a>\n                                                                                                                  <a>\n                                                                                                                    <a>\n                                                                                                                      <a>\n                                                                                                                        <a>\n                                                                                                                          <a>\n                                                                                                                            <a>\n                                                                                                                              <a>\n                                                                                                                                <a>\n                                                                                                                                <a>\n                                                                                                                                <a>\n                                                                                                                                <a>\n                                                                                                                                <a>\n                                                                                                                                <a>\n                                                                                                                                x\n                                                                                                                                </a>\n                                                                                                                                </a>\n                                                                                                                                </a>\n                                                                                                                                </a>\n                                                                                                                                </a>\n                                                                                                                                </a>\n                                                                                                                              </a>\n                                                                                                                            </a>\n                                                                                                                          </a>\n                                                                                                                        </a>\n                                                                                                                      </a>\n                                                                                                                    </a>\n                                                                                                                  </a>\n                                                                                                                </a>\n                                                                                                              </a>\n                                                                                                            </a>\n                                                                                                          </a>\n                                                                                                        </a>\n                                                                                                      </a>\n                                                                                                    </a>\n                                                                                                  </a>\n                                                                                                </a>\n                                                                                              </a>\n                                                                                            </a>\n                                                                                          </a>\n                                                                                        </a>\n                                                                                      </a>\n                                                                                    </a>\n                                                                                  </a>\n                                                                                </a>\n                                                                              </a>\n                                                                            </a>\n                                                                          </a>\n                                                                        </a>\n                                                                      </a>\n                                                                    </a>\n                                                                  </a>\n                                                                </a>\n                                                              </a>\n                                                            </a>\n                                                          </a>\n                                                        </a>\n                                                      </a>\n                                                    </a>\n                                                  </a>\n                                                </a>\n                                              </a>\n                                            </a>\n                                          </a>\n                                        </a>\n                                      </a>\n                                    </a>\n                                  </a>\n                                </a>\n                              </a>\n                            </a>\n                          </a>\n                        </a>\n                      </a>\n                    </a>\n                  </a>\n                </a>\n              </a>\n            </a>\n          </a>\n        </a>\n      </a>\n    </a>\n  </a>\n</a>"}
]

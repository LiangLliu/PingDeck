[
{"name": "root", "document": {"a": 1}, "expression": "$", "expected": [{"a": 1}], "text": "{\n  \"a\": 1\n}", "error": false},
{"name": "dot members", "document": {"a": {"b": 2}}, "expression": "$.a.b", "expected": [2], "text": "2", "error": false},
{"name": "bracket members", "document": {"a": {"b": 2}}, "expression": "$['a']['b']", "expected": [2], "text": "2", "error": false},
{"name": "double-quoted bracket member", "document": {"a": {"b": 2}}, "expression": "$[\"a\"].b", "expected": [2], "text": "2", "error": false},
{"name": "quoted key with space", "document": {"first name": "Ann"}, "expression": "$['first name']", "expected": ["Ann"], "text": "\"Ann\"", "error": false},
{"name": "quoted key with dot", "document": {"a.b": 1, "a": {"b": 2}}, "expression": "$['a.b']", "expected": [1], "text": "1", "error": false},
{"name": "all-digit member on an array is an index", "document": {"items": [{"id": 7}, {"id": 8}], "x-request-id": "r1"}, "expression": "$.items.1.id", "expected": [8], "text": "8", "error": false},
{"name": "missing member", "document": {"a": 1}, "expression": "$.zzz", "expected": [], "text": "[]", "error": false},
{"name": "cjk member name", "document": {"名前": "太郎"}, "expression": "$.名前", "expected": ["太郎"], "text": "\"太郎\"", "error": false},
{"name": "cjk member after wildcard", "document": {"items": [{"名称": "りんご"}, {"名称": "みかん"}]}, "expression": "$.items[*].名称", "expected": ["りんご", "みかん"], "text": "[\n  \"りんご\",\n  \"みかん\"\n]", "error": false},
{"name": "cjk recursive descent", "document": {"商品": {"价格": 10, "子": [{"价格": 20}, {"其他": 1}]}}, "expression": "$..价格", "expected": [10, 20], "text": "[\n  10,\n  20\n]", "error": false},
{"name": "negative index", "document": {"a": [1, 2, 3]}, "expression": "$.a[-1]", "expected": [3], "text": "3", "error": false},
{"name": "index out of range", "document": {"a": [1, 2, 3]}, "expression": "$.a[5]", "expected": [], "text": "[]", "error": false},
{"name": "negative index out of range", "document": {"a": [1, 2, 3]}, "expression": "$.a[-9]", "expected": [], "text": "[]", "error": false},
{"name": "slice", "document": {"a": [0, 1, 2, 3, 4]}, "expression": "$.a[1:3]", "expected": [1, 2], "text": "[\n  1,\n  2\n]", "error": false},
{"name": "slice open start", "document": {"a": [0, 1, 2, 3, 4]}, "expression": "$.a[:2]", "expected": [0, 1], "text": "[\n  0,\n  1\n]", "error": false},
{"name": "slice open end", "document": {"a": [0, 1, 2, 3, 4]}, "expression": "$.a[3:]", "expected": [3, 4], "text": "[\n  3,\n  4\n]", "error": false},
{"name": "slice negative start", "document": {"a": [0, 1, 2, 3, 4]}, "expression": "$.a[-2:]", "expected": [3, 4], "text": "[\n  3,\n  4\n]", "error": false},
{"name": "slice negative end", "document": {"a": [0, 1, 2, 3, 4]}, "expression": "$.a[:-1]", "expected": [0, 1, 2, 3], "text": "[\n  0,\n  1,\n  2,\n  3\n]", "error": false},
{"name": "slice empty range", "document": {"a": [0, 1, 2, 3, 4]}, "expression": "$.a[3:1]", "expected": [], "text": "[]", "error": false},
{"name": "union of keys", "document": {"a": 1, "b": 2, "c": 3}, "expression": "$['c','a']", "expected": [3, 1], "text": "[\n  3,\n  1\n]", "error": false},
{"name": "union of indices", "document": {"a": [10, 20, 30]}, "expression": "$.a[2,0]", "expected": [30, 10], "text": "[\n  30,\n  10\n]", "error": false},
{"name": "union skips missing index", "document": {"a": [10, 20, 30]}, "expression": "$.a[0,9,1]", "expected": [10, 20], "text": "[\n  10,\n  20\n]", "error": false},
{"name": "wildcard on array", "document": {"a": [10, 20, 30]}, "expression": "$.a[*]", "expected": [10, 20, 30], "text": "[\n  10,\n  20,\n  30\n]", "error": false},
{"name": "wildcard on object in document order", "document": {"o": {"y": 1, "x": [2]}}, "expression": "$.o.*", "expected": [1, [2]], "text": "[\n  1,\n  [\n    2\n  ]\n]", "error": false},
{"name": "bracket wildcard on object", "document": {"o": {"y": 1, "x": [2]}}, "expression": "$.o[*]", "expected": [1, [2]], "text": "[\n  1,\n  [\n    2\n  ]\n]", "error": false},
{"name": "recursive descent through arrays", "document": {"a": [{"id": 1, "c": [{"id": 2}]}, {"id": 3}]}, "expression": "$..id", "expected": [1, 2, 3], "text": "[\n  1,\n  2,\n  3\n]", "error": false},
{"name": "recursive descent matches at every depth", "document": {"id": 1, "x": {"id": 2}}, "expression": "$..id", "expected": [1, 2], "text": "[\n  1,\n  2\n]", "error": false},
{"name": "key fan-out over array", "document": {"items": [{"id": 1}, {"id": 2}, {"n": 3}]}, "expression": "$.items.id", "expected": [1, 2], "text": "[\n  1,\n  2\n]", "error": false},
{"name": "filter number ==", "document": {"items": [{"name": "a", "price": 5}, {"name": "b", "price": 10}, {"name": "c", "price": 15}]}, "expression": "$.items[?(@.price == 10)]", "expected": [{"name": "b", "price": 10}], "text": "{\n  \"name\": \"b\",\n  \"price\": 10\n}", "error": false},
{"name": "filter number == compares numerically", "document": {"items": [{"name": "a", "price": 5}, {"name": "b", "price": 10}, {"name": "c", "price": 15}]}, "expression": "$.items[?(@.price == 10.0)]", "expected": [{"name": "b", "price": 10}], "text": "{\n  \"name\": \"b\",\n  \"price\": 10\n}", "error": false},
{"name": "filter number !=", "document": {"items": [{"name": "a", "price": 5}, {"name": "b", "price": 10}, {"name": "c", "price": 15}]}, "expression": "$.items[?(@.price != 10)]", "expected": [{"name": "a", "price": 5}, {"name": "c", "price": 15}], "text": "[\n  {\n    \"name\": \"a\",\n    \"price\": 5\n  },\n  {\n    \"name\": \"c\",\n    \"price\": 15\n  }\n]", "error": false},
{"name": "filter number <", "document": {"items": [{"name": "a", "price": 5}, {"name": "b", "price": 10}, {"name": "c", "price": 15}]}, "expression": "$.items[?(@.price < 10)]", "expected": [{"name": "a", "price": 5}], "text": "{\n  \"name\": \"a\",\n  \"price\": 5\n}", "error": false},
{"name": "filter number <=", "document": {"items": [{"name": "a", "price": 5}, {"name": "b", "price": 10}, {"name": "c", "price": 15}]}, "expression": "$.items[?(@.price <= 10)]", "expected": [{"name": "a", "price": 5}, {"name": "b", "price": 10}], "text": "[\n  {\n    \"name\": \"a\",\n    \"price\": 5\n  },\n  {\n    \"name\": \"b\",\n    \"price\": 10\n  }\n]", "error": false},
{"name": "filter number >", "document": {"items": [{"name": "a", "price": 5}, {"name": "b", "price": 10}, {"name": "c", "price": 15}]}, "expression": "$.items[?(@.price > 10)]", "expected": [{"name": "c", "price": 15}], "text": "{\n  \"name\": \"c\",\n  \"price\": 15\n}", "error": false},
{"name": "filter number >=", "document": {"items": [{"name": "a", "price": 5}, {"name": "b", "price": 10}, {"name": "c", "price": 15}]}, "expression": "$.items[?(@.price >= 10)]", "expected": [{"name": "b", "price": 10}, {"name": "c", "price": 15}], "text": "[\n  {\n    \"name\": \"b\",\n    \"price\": 10\n  },\n  {\n    \"name\": \"c\",\n    \"price\": 15\n  }\n]", "error": false},
{"name": "filter then member", "document": {"items": [{"name": "a", "price": 5}, {"name": "b", "price": 10}, {"name": "c", "price": 15}]}, "expression": "$.items[?(@.price > 10)].name", "expected": ["c"], "text": "\"c\"", "error": false},
{"name": "filter tolerates whitespace", "document": {"items": [{"name": "a", "price": 5}, {"name": "b", "price": 10}, {"name": "c", "price": 15}]}, "expression": "$.items[?( @.price   >=   10 )].name", "expected": ["b", "c"], "text": "[\n  \"b\",\n  \"c\"\n]", "error": false},
{"name": "filter without whitespace", "document": {"items": [{"name": "a", "price": 5}, {"name": "b", "price": 10}, {"name": "c", "price": 15}]}, "expression": "$.items[?(@.price>=10)].name", "expected": ["b", "c"], "text": "[\n  \"b\",\n  \"c\"\n]", "error": false},
{"name": "filter negative number literal", "document": {"items": [{"t": -5}, {"t": 3}]}, "expression": "$.items[?(@.t < 0)].t", "expected": [-5], "text": "-5", "error": false},
{"name": "filter decimal literal", "document": {"items": [{"t": -5}, {"t": 3}]}, "expression": "$.items[?(@.t > -2.5)].t", "expected": [3], "text": "3", "error": false},
{"name": "filter string == single quotes", "document": {"items": [{"n": "apple"}, {"n": "banana"}, {"n": "cherry"}]}, "expression": "$.items[?(@.n == 'banana')].n", "expected": ["banana"], "text": "\"banana\"", "error": false},
{"name": "filter string == double quotes", "document": {"items": [{"n": "apple"}, {"n": "banana"}, {"n": "cherry"}]}, "expression": "$.items[?(@.n == \"banana\")].n", "expected": ["banana"], "text": "\"banana\"", "error": false},
{"name": "filter string !=", "document": {"items": [{"n": "apple"}, {"n": "banana"}, {"n": "cherry"}]}, "expression": "$.items[?(@.n != 'banana')].n", "expected": ["apple", "cherry"], "text": "[\n  \"apple\",\n  \"cherry\"\n]", "error": false},
{"name": "filter string <", "document": {"items": [{"n": "apple"}, {"n": "banana"}, {"n": "cherry"}]}, "expression": "$.items[?(@.n < 'banana')].n", "expected": ["apple"], "text": "\"apple\"", "error": false},
{"name": "filter string <=", "document": {"items": [{"n": "apple"}, {"n": "banana"}, {"n": "cherry"}]}, "expression": "$.items[?(@.n <= 'banana')].n", "expected": ["apple", "banana"], "text": "[\n  \"apple\",\n  \"banana\"\n]", "error": false},
{"name": "filter string >", "document": {"items": [{"n": "apple"}, {"n": "banana"}, {"n": "cherry"}]}, "expression": "$.items[?(@.n > 'banana')].n", "expected": ["cherry"], "text": "\"cherry\"", "error": false},
{"name": "filter string >=", "document": {"items": [{"n": "apple"}, {"n": "banana"}, {"n": "cherry"}]}, "expression": "$.items[?(@.n >= 'banana')].n", "expected": ["banana", "cherry"], "text": "[\n  \"banana\",\n  \"cherry\"\n]", "error": false},
{"name": "filter string literal with escaped quote", "document": {"items": [{"n": "it's"}, {"n": "x"}]}, "expression": "$.items[?(@.n == 'it\\'s')].n", "expected": ["it's"], "text": "\"it's\"", "error": false},
{"name": "filter cjk string ==", "document": {"items": [{"名称": "りんご", "価格": 100}, {"名称": "みかん", "価格": 50}]}, "expression": "$.items[?(@.名称 == 'みかん')].価格", "expected": [50], "text": "50", "error": false},
{"name": "filter cjk string >", "document": {"items": [{"名称": "りんご", "価格": 100}, {"名称": "みかん", "価格": 50}]}, "expression": "$.items[?(@.名称 > 'みかん')].名称", "expected": ["りんご"], "text": "\"りんご\"", "error": false},
{"name": "filter string order is UTF-16 code units", "document": {"items": [{"s": "😀"}, {"s": "～"}]}, "expression": "$.items[?(@.s < '～')].s", "expected": ["😀"], "text": "\"😀\"", "error": false},
{"name": "filter == matches only the same type", "document": {"items": [{"v": 1}, {"v": "1"}, {"v": true}, {"v": null}, {"v": [1]}]}, "expression": "$.items[?(@.v == 1)]", "expected": [{"v": 1}], "text": "{\n  \"v\": 1\n}", "error": false},
{"name": "filter string == does not match number", "document": {"items": [{"v": 1}, {"v": "1"}, {"v": true}, {"v": null}, {"v": [1]}]}, "expression": "$.items[?(@.v == '1')]", "expected": [{"v": "1"}], "text": "{\n  \"v\": \"1\"\n}", "error": false},
{"name": "filter != is true across types", "document": {"items": [{"v": 1}, {"v": "1"}, {"v": true}, {"v": null}, {"v": [1]}]}, "expression": "$.items[?(@.v != 1)]", "expected": [{"v": "1"}, {"v": true}, {"v": null}, {"v": [1]}], "text": "[\n  {\n    \"v\": \"1\"\n  },\n  {\n    \"v\": true\n  },\n  {\n    \"v\": null\n  },\n  {\n    \"v\": [\n      1\n    ]\n  }\n]", "error": false},
{"name": "filter ordering needs same type", "document": {"items": [{"v": 1}, {"v": "1"}, {"v": true}, {"v": null}, {"v": [1]}]}, "expression": "$.items[?(@.v > 0)]", "expected": [{"v": 1}], "text": "{\n  \"v\": 1\n}", "error": false},
{"name": "filter bool ==", "document": {"items": [{"v": 1}, {"v": "1"}, {"v": true}, {"v": null}, {"v": [1]}]}, "expression": "$.items[?(@.v == true)]", "expected": [{"v": true}], "text": "{\n  \"v\": true\n}", "error": false},
{"name": "filter null ==", "document": {"items": [{"v": 1}, {"v": "1"}, {"v": true}, {"v": null}, {"v": [1]}]}, "expression": "$.items[?(@.v == null)]", "expected": [{"v": null}], "text": "{\n  \"v\": null\n}", "error": false},
{"name": "filter != null", "document": {"items": [{"v": 1}, {"v": "1"}, {"v": true}, {"v": null}, {"v": [1]}]}, "expression": "$.items[?(@.v != null)]", "expected": [{"v": 1}, {"v": "1"}, {"v": true}, {"v": [1]}], "text": "[\n  {\n    \"v\": 1\n  },\n  {\n    \"v\": \"1\"\n  },\n  {\n    \"v\": true\n  },\n  {\n    \"v\": [\n      1\n    ]\n  }\n]", "error": false},
{"name": "filter ordering on booleans is false", "document": {"items": [{"v": 1}, {"v": "1"}, {"v": true}, {"v": null}, {"v": [1]}]}, "expression": "$.items[?(@.v > true)]", "expected": [], "text": "[]", "error": false},
{"name": "filter == false does not match null", "document": {"items": [{"v": false}, {"v": null}, {"v": 0}]}, "expression": "$.items[?(@.v == false)]", "expected": [{"v": false}], "text": "{\n  \"v\": false\n}", "error": false},
{"name": "missing path is false for !=", "document": {"items": [{"a": 1}, {"b": 2}]}, "expression": "$.items[?(@.a != 1)]", "expected": [], "text": "[]", "error": false},
{"name": "missing path is skipped by != on other values", "document": {"items": [{"a": 1}, {"b": 2}]}, "expression": "$.items[?(@.a != 5)]", "expected": [{"a": 1}], "text": "{\n  \"a\": 1\n}", "error": false},
{"name": "missing path is false for ==", "document": {"items": [{"a": 1}, {"b": 2}]}, "expression": "$.items[?(@.a == null)]", "expected": [], "text": "[]", "error": false},
{"name": "existence filter counts null and false", "document": {"items": [{"a": 1}, {"a": null}, {"a": false}, {"b": 0}]}, "expression": "$.items[?(@.a)]", "expected": [{"a": 1}, {"a": null}, {"a": false}], "text": "[\n  {\n    \"a\": 1\n  },\n  {\n    \"a\": null\n  },\n  {\n    \"a\": false\n  }\n]", "error": false},
{"name": "nested filter path ==", "document": {"items": [{"a": {"b": 1}}, {"a": {"b": 2}}, {"a": 5}, {"a": {"c": 1}}]}, "expression": "$.items[?(@.a.b == 2)]", "expected": [{"a": {"b": 2}}], "text": "{\n  \"a\": {\n    \"b\": 2\n  }\n}", "error": false},
{"name": "nested existence filter", "document": {"items": [{"a": {"b": 1}}, {"a": {"b": 2}}, {"a": 5}, {"a": {"c": 1}}]}, "expression": "$.items[?(@.a.b)]", "expected": [{"a": {"b": 1}}, {"a": {"b": 2}}], "text": "[\n  {\n    \"a\": {\n      \"b\": 1\n    }\n  },\n  {\n    \"a\": {\n      \"b\": 2\n    }\n  }\n]", "error": false},
{"name": "filter over object values", "document": {"o": {"x": {"k": 1}, "y": {"k": 2}}}, "expression": "$.o[?(@.k == 2)]", "expected": [{"k": 2}], "text": "{\n  \"k\": 2\n}", "error": false},
{"name": "filter over scalar children yields nothing", "document": {"a": [1, 2, 3]}, "expression": "$.a[?(@.x)]", "expected": [], "text": "[]", "error": false},
{"name": "filter on a scalar node yields nothing", "document": {"a": 5}, "expression": "$.a[?(@.x)]", "expected": [], "text": "[]", "error": false},
{"name": "descent then filter", "document": {"shop": {"items": [{"p": 5}, {"p": 15}]}, "stall": {"items": [{"p": 20}]}}, "expression": "$..items[?(@.p > 10)]", "expected": [{"p": 15}, {"p": 20}], "text": "[\n  {\n    \"p\": 15\n  },\n  {\n    \"p\": 20\n  }\n]", "error": false},
{"name": "no matches", "document": {"items": [{"name": "a", "price": 5}, {"name": "b", "price": 10}, {"name": "c", "price": 15}]}, "expression": "$.items[?(@.price > 100)]", "expected": [], "text": "[]", "error": false},
{"name": "missing dollar", "document": {"a": [1, 2, 3], "items": [{"a": 1}]}, "expression": "store.book", "expected": null, "message": "JSONPath must start with \"$\"", "error": true},
{"name": "unclosed bracket", "document": {"a": [1, 2, 3], "items": [{"a": 1}]}, "expression": "$.items[", "expected": null, "message": "Unclosed \"[\" in JSONPath", "error": true},
{"name": "slice with three parts", "document": {"a": [1, 2, 3], "items": [{"a": 1}]}, "expression": "$.a[1:2:3]", "expected": null, "message": "Unsupported slice \"1:2:3\" · use [start:end]", "error": true},
{"name": "slice bound is not a number", "document": {"a": [1, 2, 3], "items": [{"a": 1}]}, "expression": "$.a[x:2]", "expected": null, "message": "Slice bound \"x\" is not a number", "error": true},
{"name": "unsupported selector", "document": {"a": [1, 2, 3], "items": [{"a": 1}]}, "expression": "$.a[abc]", "expected": null, "message": "Unsupported selector \"abc\"", "error": true},
{"name": "unsupported && filter", "document": {"a": [1, 2, 3], "items": [{"a": 1}]}, "expression": "$.items[?(@.a && @.b)]", "expected": null, "message": "Unsupported filter expression · use [?(@.path OP literal)] or [?(@.path)]", "error": true},
{"name": "unsupported || filter", "document": {"a": [1, 2, 3], "items": [{"a": 1}]}, "expression": "$.items[?(@.a > 1 || @.b)]", "expected": null, "message": "Unsupported filter expression · use [?(@.path OP literal)] or [?(@.path)]", "error": true},
{"name": "unsupported regex filter", "document": {"a": [1, 2, 3], "items": [{"a": 1}]}, "expression": "$.items[?(@.a =~ 'x')]", "expected": null, "message": "Unsupported filter expression · use [?(@.path OP literal)] or [?(@.path)]", "error": true},
{"name": "unsupported function filter", "document": {"a": [1, 2, 3], "items": [{"a": 1}]}, "expression": "$.items[?(length(@.a) > 1)]", "expected": null, "message": "Unsupported filter expression · use [?(@.path OP literal)] or [?(@.path)]", "error": true},
{"name": "filter missing literal", "document": {"a": [1, 2, 3], "items": [{"a": 1}]}, "expression": "$.items[?(@.a == )]", "expected": null, "message": "Unsupported filter expression · use [?(@.path OP literal)] or [?(@.path)]", "error": true},
{"name": "filter without parentheses", "document": {"a": [1, 2, 3], "items": [{"a": 1}]}, "expression": "$.items[?@.a]", "expected": null, "message": "Unsupported filter expression · use [?(@.path OP literal)] or [?(@.path)]", "error": true},
{"name": "empty expression", "document": {"a": [1, 2, 3], "items": [{"a": 1}]}, "expression": "", "expected": null, "message": "Enter a JSONPath expression, for example $.items[*].id", "error": true},
{"name": "blank expression", "document": {"a": [1, 2, 3], "items": [{"a": 1}]}, "expression": "   ", "expected": null, "message": "Enter a JSONPath expression, for example $.items[*].id", "error": true},
{"name": "dot without name", "document": {"a": [1, 2, 3], "items": [{"a": 1}]}, "expression": "$.", "expected": null, "message": "Expected a property name at position 3", "error": true},
{"name": "recursive descent without name", "document": {"a": [1, 2, 3], "items": [{"a": 1}]}, "expression": "$..", "expected": null, "message": "Expected a property name at position 4", "error": true},
{"name": "current node number ==", "document": {"a": [1, 2, 3, "2", true, null]}, "expression": "$.a[?(@ == 2)]", "expected": [2], "text": "2", "error": false},
{"name": "current node number !=", "document": {"a": [1, 2, 3]}, "expression": "$.a[?(@ != 2)]", "expected": [1, 3], "text": "[\n  1,\n  3\n]", "error": false},
{"name": "current node number >", "document": {"a": [1, 2, 3, "9"]}, "expression": "$.a[?(@ > 1)]", "expected": [2, 3], "text": "[\n  2,\n  3\n]", "error": false},
{"name": "current node number <= without whitespace", "document": {"a": [1, 2, 3]}, "expression": "$.a[?(@<=2)]", "expected": [1, 2], "text": "[\n  1,\n  2\n]", "error": false},
{"name": "current node string ==", "document": {"a": ["x", "y", 1]}, "expression": "$.a[?(@ == 'y')]", "expected": ["y"], "text": "\"y\"", "error": false},
{"name": "current node string !=", "document": {"a": ["x", "y", 1]}, "expression": "$.a[?(@ != 'x')]", "expected": ["y", 1], "text": "[\n  \"y\",\n  1\n]", "error": false},
{"name": "current node string >", "document": {"a": ["x", "y", "z", 1]}, "expression": "$.a[?(@ > 'x')]", "expected": ["y", "z"], "text": "[\n  \"y\",\n  \"z\"\n]", "error": false},
{"name": "current node bool ==", "document": {"a": [true, false, 1, "true", null]}, "expression": "$.a[?(@ == true)]", "expected": [true], "text": "true", "error": false},
{"name": "current node bool !=", "document": {"a": [true, false, 1]}, "expression": "$.a[?(@ != true)]", "expected": [false, 1], "text": "[\n  false,\n  1\n]", "error": false},
{"name": "current node null ==", "document": {"a": [null, false, 0, ""]}, "expression": "$.a[?(@ == null)]", "expected": [null], "text": "null", "error": false},
{"name": "current node null !=", "document": {"a": [null, false, 0]}, "expression": "$.a[?(@ != null)]", "expected": [false, 0], "text": "[\n  false,\n  0\n]", "error": false},
{"name": "current node over object values", "document": {"o": {"x": 1, "y": 2}}, "expression": "$.o[?(@ == 2)]", "expected": [2], "text": "2", "error": false},
{"name": "current node bare existence is rejected", "document": {"a": [1, 2]}, "expression": "$.a[?(@)]", "expected": null, "message": "Unsupported filter expression · use [?(@.path OP literal)] or [?(@.path)]", "error": true},
{"name": "current node without dot before name is rejected", "document": {"a": [1, 2]}, "expression": "$.a[?(@x == 1)]", "expected": null, "message": "Unsupported filter expression · use [?(@.path OP literal)] or [?(@.path)]", "error": true},

{
  "description": "Language-neutral cases for the request URL sync (crates/spanbay-core/src/app/request_model_service/url_sync.rs). Each case: inputs plus `expected`. Rows are {key,value,enabled}. Generated from the Rust core, cross-checked against the former TypeScript (src/state/tabs/draft.ts); the module docs list the deliberate differences. Consumed by crates/spanbay-core/tests/url_sync_fixture.rs and src/api/logic/requestModel.test.ts.",
  "merge_path_variables": [
    {
      "url": "https://x/:id/:name",
      "existing": [
        {
          "key": "name",
          "value": "bob",
          "enabled": false
        },
        {
          "key": "id",
          "value": "7",
          "enabled": true
        }
      ],
      "expected": [
        {
          "key": "id",
          "value": "7",
          "enabled": true
        },
        {
          "key": "name",
          "value": "bob",
          "enabled": false
        }
      ],
      "name": "reuses value and enabled flag by key"
    },
    {
      "url": "https://x/:id",
      "existing": [
        {
          "key": "id",
          "value": "7",
          "enabled": true
        },
        {
          "key": "gone",
          "value": "x",
          "enabled": true
        }
      ],
      "expected": [
        {
          "key": "id",
          "value": "7",
          "enabled": true
        }
      ],
      "name": "drops variables absent from url"
    },
    {
      "url": "https://x/:id/{slug}",
      "existing": [],
      "expected": [
        {
          "key": "id",
          "value": "",
          "enabled": true
        },
        {
          "key": "slug",
          "value": "",
          "enabled": true
        }
      ],
      "name": "new names start empty and enabled"
    },
    {
      "url": "https://x/:b/:a",
      "existing": [
        {
          "key": "a",
          "value": "1",
          "enabled": true
        },
        {
          "key": "b",
          "value": "2",
          "enabled": true
        }
      ],
      "expected": [
        {
          "key": "b",
          "value": "2",
          "enabled": true
        },
        {
          "key": "a",
          "value": "1",
          "enabled": true
        }
      ],
      "name": "order follows url"
    },
    {
      "url": "https://x/:id",
      "existing": [
        {
          "key": "id",
          "value": "first",
          "enabled": true
        },
        {
          "key": "id",
          "value": "second",
          "enabled": true
        }
      ],
      "expected": [
        {
          "key": "id",
          "value": "first",
          "enabled": true
        }
      ],
      "name": "first duplicate wins"
    },
    {
      "url": "https://x/plain",
      "existing": [
        {
          "key": "id",
          "value": "7",
          "enabled": true
        }
      ],
      "expected": [],
      "name": "no variables"
    }
  ],
  "path_variable_names": [
    {
      "url": "https://x/users/:id/posts/:postId",
      "expected": [
        "id",
        "postId"
      ],
      "name": "colon variables"
    },
    {
      "url": "https://x/users/{id}/posts/{postId}",
      "expected": [
        "id",
        "postId"
      ],
      "name": "brace variables"
    },
    {
      "url": "https://x/{a}/:b/{c}/:d",
      "expected": [
        "a",
        "b",
        "c",
        "d"
      ],
      "name": "mixed forms keep url order"
    },
    {
      "url": "https://x/:id/items/:id/{id}",
      "expected": [
        "id"
      ],
      "name": "duplicates collapse"
    },
    {
      "url": "https://x/a?x=:y&z={w}#:v",
      "expected": [],
      "name": "query and fragment ignored"
    },
    {
      "url": "{{baseUrl}}/users/:id/{{other}}",
      "expected": [
        "id"
      ],
      "name": "variable tokens ignored"
    },
    {
      "url": "{{baseUrl}}/{{userId}}",
      "expected": [],
      "name": "only variable tokens"
    },
    {
      "url": "http://localhost:3000/users/:id",
      "expected": [
        "id"
      ],
      "name": "port is not a variable"
    },
    {
      "url": "http://localhost:port/users",
      "expected": [],
      "name": "host port name is not a variable"
    },
    {
      "url": "http://{{host}}:8080/:id",
      "expected": [
        "id"
      ],
      "name": "token host with port"
    },
    {
      "url": "http://{{host}}:port/x",
      "expected": [],
      "name": "token host with port name"
    },
    {
      "url": "https://x/:user_id/:a1/:_",
      "expected": [
        "user_id",
        "a1",
        "_"
      ],
      "name": "underscore and digits"
    },
    {
      "url": "https://x/:1abc/{1a}",
      "expected": [
        "1abc"
      ],
      "name": "a :name may start with a digit but a {name} may not"
    },
    {
      "url": "https://x/:a-b/:c.json",
      "expected": [
        "a",
        "c"
      ],
      "name": "name stops at non word"
    },
    {
      "url": "https://x/{a b}/{}/{a-b}",
      "expected": [],
      "name": "invalid brace names"
    },
    {
      "url": "https://x/{{a}}/{{{b}}}",
      "expected": [],
      "name": "double braces never a path variable"
    },
    {
      "url": "https://x/{{a}}{b}",
      "expected": [
        "b"
      ],
      "name": "brace after token"
    },
    {
      "url": "https://x/用户/:id/é/{name}",
      "expected": [
        "id",
        "name"
      ],
      "name": "unicode path"
    },
    {
      "url": "https://x/a:b/c",
      "expected": [],
      "name": "colon not after slash"
    },
    {
      "url": "localhost:3001/:id",
      "expected": [
        "id"
      ],
      "name": "scheme-less"
    },
    {
      "url": "",
      "expected": [],
      "name": "empty url"
    },
    {
      "url": "https://x/{{p?q}}/:id/items",
      "expected": [
        "id"
      ],
      "name": "a ? inside a token does not end the path"
    },
    {
      "url": "https://x/{{p#q}}/:id?x=:no",
      "expected": [
        "id"
      ],
      "name": "a # inside a token does not end the path, the real ? does"
    },
    {
      "url": "https://x/:1/:a_1/:9b",
      "expected": [
        "1",
        "a_1",
        "9b"
      ],
      "name": "a :name is [A-Za-z0-9_]+ and may start with a digit, like the executor"
    },
    {
      "url": "https://x/a:b/:c-d/:e.f",
      "expected": [
        "c",
        "e"
      ],
      "name": "a colon only counts right after a slash, and the name stops at the first other character"
    },
    {
      "url": "https://x/{1a}/{ok}",
      "expected": [
        "ok"
      ],
      "name": "a {name} still needs an identifier"
    }
  ],

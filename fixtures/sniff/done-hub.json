{
  "name": "done-hub",
  "input": {
    "base_url": "hub.example.org",
    "api_key": "sk-test-0123456789abcdefABCD",
    "protocol_override": "openai_chat"
  },
  "routes": [
    {
      "method": "GET",
      "path": "/api/status",
      "status": 200,
      "body": {
        "success": true,
        "data": {
          "version": "v0.3.1",
          "system_name": "My DoneHub",
          "quota_per_unit": 500000
        }
      }
    },
    {
      "method": "GET",
      "path": "/v1/models",
      "status": 200,
      "body": {
        "object": "list",
        "data": [
          {
            "id": "gpt-4o",
            "object": "model",
            "owned_by": "x"
          }
        ]
      }
    },
    {
      "method": "POST",
      "path": "/v1/chat/completions",
      "status": 400,
      "body": {
        "error": {
          "message": "you must provide a model parameter",
          "type": "invalid_request_error",
          "code": null
        }
      }
    },
    {
      "method": "GET",
      "path": "/api/usage/token/",
      "status": 200,
      "body": {
        "code": true,
        "data": {
          "total_available": 1000000,
          "unlimited_quota": false
        }
      }
    }
  ],
  "expect": {
    "family": "done_hub",
    "brand": "My DoneHub",
    "confirmed": true,
    "quota_is_remaining": true,
    "protocols": {
      "chat": 400
    },
    "models": 1,
    "key_status": "accepted",
    "max_requests": 12,
    "requests": 4,
    "warnings": [],
    "balance": {
      "unit": "quota",
      "value": 1000000,
      "remaining_usd": 2.0
    }
  }
}

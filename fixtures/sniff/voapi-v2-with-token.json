{
  "name": "voapi-v2-with-token",
  "input": {
    "base_url": "vo.example.org",
    "api_key": "sk-test-0123456789abcdefABCD",
    "management_token": "console-jwt-abcdef0123456789",
    "protocol_override": "openai_chat"
  },
  "routes": [
    {
      "method": "GET",
      "path": "/api/status",
      "status": 404,
      "headers": {
        "content-type": "text/plain"
      },
      "text": "404 page not found"
    },
    {
      "method": "GET",
      "path": "/api/v1/auth/me",
      "status": 401,
      "body": {
        "code": 401,
        "message": "unauthorized"
      }
    },
    {
      "method": "GET",
      "path": "/api/user/info",
      "when": [
        {
          "header_present": "authorization"
        }
      ],
      "status": 200,
      "body": {
        "code": 0,
        "data": {
          "id": 7,
          "username": "ann",
          "basicBalance": "12.40",
          "bindBalance": "0.00",
          "currency": "USD"
        }
      }
    },
    {
      "method": "GET",
      "path": "/v1/models",
      "status": 200,
      "body": {
        "object": "list",
        "data": [
          {
            "id": "gpt-4o",
            "object": "model",
            "owned_by": "x"
          }
        ]
      }
    },
    {
      "method": "POST",
      "path": "/v1/chat/completions",
      "status": 400,
      "body": {
        "error": {
          "message": "you must provide a model parameter",
          "type": "invalid_request_error",
          "code": null
        }
      }
    }
  ],
  "expect": {
    "family": "vo_api",
    "confirmed": true,
    "protocols": {
      "chat": 400
    },
    "models": 1,
    "max_requests": 12,
    "warnings": []
  }
}

{
  "name": "volcengine-api-v3",
  "input": {
    "base_url": "https://ark.cn-beijing.volces.com/api/v3",
    "api_key": "sk-test-0123456789abcdefABCD"
  },
  "routes": [
    {
      "method": "GET",
      "path": "/api/v3/models",
      "status": 200,
      "body": {
        "object": "list",
        "data": [
          {
            "id": "doubao-seed-2-0-pro",
            "object": "model",
            "owned_by": "x"
          }
        ]
      }
    },
    {
      "method": "POST",
      "path": "/api/v3/chat/completions",
      "status": 400,
      "body": {
        "error": {
          "message": "you must provide a model parameter",
          "type": "invalid_request_error",
          "code": null
        }
      }
    },
    {
      "method": "POST",
      "path": "/api/compatible/v1/messages",
      "status": 400,
      "body": {
        "type": "error",
        "error": {
          "type": "invalid_request_error",
          "message": "model: field required"
        }
      }
    },
    {
      "method": "POST",
      "path": "/api/v3/responses",
      "status": 404,
      "headers": {
        "content-type": "text/plain"
      },
      "text": "404 page not found"
    }
  ],
  "expect": {
    "family": "official",
    "label": "preset",
    "models": 1,
    "protocols": {
      "chat": 400,
      "messages": 400,
      "responses": "absent"
    },
    "max_requests": 12,
    "requests": 4,
    "warnings": [
      "preset_route_mismatch"
    ],
    "models_endpoint": "/api/v3/models",
    "never_prefix": [
      "/v1"
    ],
    "suggested_preset_id": "doubao_ark"
  }
}

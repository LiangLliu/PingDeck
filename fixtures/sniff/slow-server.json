        }
      },
      "delay_ms": 6000
    },
    {
      "method": "POST",
      "path": "/v1/responses",
      "status": 400,
      "body": {
        "error": {
          "message": "you must provide a model parameter",
          "type": "invalid_request_error",
          "code": null
        }
      },
      "delay_ms": 6000
    },
    {
      "method": "POST",
      "path": "/v1/embeddings",
      "status": 400,
      "body": {
        "error": {
          "message": "you must provide a model parameter",
          "type": "invalid_request_error",
          "code": null
        }
      },
      "delay_ms": 6000
    }
  ],
  "expect": {
    "family": "unknown_compatible",
    "models": 2,
    "max_requests": 12,
    "requests": 10,
    "warnings": [],
    "protocols": {
      "chat": "timeout",

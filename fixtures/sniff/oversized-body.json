{
  "name": "oversized-body",
  "input": {
    "base_url": "big.example.org",
    "api_key": "sk-test-0123456789abcdefABCD",
    "protocol_override": "openai_chat"
  },
  "routes": [
    {
      "method": "GET",
      "path": "/api/status",
      "status": 200,
      "headers": {
        "content-type": "text/plain"
      },
      "raw_bytes_len": 1048576
    },
    {
      "method": "GET",
      "path": "/api/v1/auth/me",
      "status": 404,
      "headers": {
        "content-type": "text/plain"
      },
      "text": "404 page not found"
    },
    {
      "method": "GET",
      "path": "/v1/models",
      "status": 200,
      "body": {
        "object": "list",
        "data": [
          {
            "id": "gpt-4o",
            "object": "model",
            "owned_by": "x"
          }
        ]
      }
    },
    {
      "method": "POST",
      "path": "/v1/chat/completions",
      "status": 400,
      "body": {
        "error": {
          "message": "you must provide a model parameter",
          "type": "invalid_request_error",
          "code": null
        }
      }
    }
  ],
  "expect": {
    "family": "unknown_compatible",
    "models": 1,
    "max_requests": 12,
    "requests": 3,
    "warnings": [
      "body_truncated"
    ],
    "protocols": {
      "chat": 400
    }
  }
}

{
  "name": "litellm",
  "input": {
    "base_url": "llm.example.org",
    "api_key": "sk-test-0123456789abcdefABCD"
  },
  "routes": [
    {
      "method": "GET",
      "path": "/api/status",
      "status": 404,
      "headers": {
        "x-litellm-version": "1.80.0",
        "x-litellm-call-id": "abc",
        "content-type": "application/json"
      },
      "text": "{\"detail\":\"Not Found\"}"
    },
    {
      "method": "GET",
      "path": "/v1/models",
      "status": 200,
      "headers": {
        "x-litellm-version": "1.80.0",
        "x-litellm-call-id": "abc"
      },
      "body": {
        "object": "list",
        "data": [
          {
            "id": "gpt-4o",
            "object": "model",
            "owned_by": "x"
          }
        ]
      }
    },
    {
      "method": "POST",
      "path": "/v1/chat/completions",
      "status": 400,
      "headers": {
        "x-litellm-version": "1.80.0",
        "x-litellm-call-id": "abc"
      },
      "body": {
        "error": {
          "message": "you must provide a model parameter",
          "type": "invalid_request_error",
          "code": null
        }
      }
    },
    {
      "method": "GET",
      "path": "/model/info",
      "status": 200,
      "headers": {
        "x-litellm-version": "1.80.0",
        "x-litellm-call-id": "abc"
      },
      "body": {
        "data": [
          {
            "model_name": "gpt-4o",
            "litellm_params": {
              "model": "openai/gpt-4o"
            },
            "model_info": {}
          }
        ]
      }
    },
    {
      "method": "GET",
      "path": "/key/info",
      "status": 200,
      "headers": {
        "x-litellm-version": "1.80.0",
        "x-litellm-call-id": "abc"
      },
      "body": {
        "key": "x",
        "info": {
          "spend": 1.5,
          "max_budget": 10.0
        }
      }
    },
    {
      "method": "GET",
      "path": "/v2/user/info",
      "status": 200,
      "headers": {
        "x-litellm-version": "1.80.0",
        "x-litellm-call-id": "abc"
      },
      "body": {
        "user_id": "u",
        "spend": 1.5,
        "max_budget": 20.0
      }
    }
  ],
  "expect": {
    "family": "lite_llm",
    "version": "1.80.0",
    "confirmed": true,
    "protocols": {
      "chat": 400
    },
    "models": 1,
    "max_requests": 12,
    "requests": 12,
    "warnings": [],
    "model_info_requested": true
  }
}

{
  "name": "cliproxyapi-port-only",
  "input": {
    "base_url": "http://localhost:8317",
    "protocol_override": "openai_chat"
  },
  "routes": [
    {
      "method": "GET",
      "path": "/v1/models",
      "status": 200,
      "body": {
        "object": "list",
        "data": [
          {
            "id": "gpt-5",
            "object": "model",
            "owned_by": "x"
          }
        ]
      }
    },
    {
      "method": "POST",
      "path": "/v1/chat/completions",
      "status": 400,
      "body": {
        "error": {
          "message": "you must provide a model parameter",
          "type": "invalid_request_error",
          "code": null
        }
      }
    }
  ],
  "expect": {
    "family": "unknown_compatible",
    "label": "compatible_unidentified",
    "models": 1,
    "max_requests": 8,
    "requests": 2,
    "protocols": {
      "chat": 400
    },
    "warnings": []
  }
}

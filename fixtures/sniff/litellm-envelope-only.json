{
  "name": "litellm-envelope-only",
  "input": {
    "base_url": "llm.example.org",
    "api_key": "sk-test-0123456789abcdefABCD",
    "protocol_override": "openai_chat"
  },
  "routes": [
    {
      "method": "GET",
      "path": "/api/status",
      "status": 404,
      "headers": {
        "content-type": "text/plain"
      },
      "text": "404 page not found"
    },
    {
      "method": "GET",
      "path": "/api/v1/auth/me",
      "status": 404,
      "text": "{\"detail\":\"Not Found\"}"
    },
    {
      "method": "GET",
      "path": "/v1/models",
      "status": 200,
      "body": {
        "object": "list",
        "data": [
          {
            "id": "gpt-4o",
            "object": "model",
            "owned_by": "x"
          }
        ]
      }
    },
    {
      "method": "POST",
      "path": "/v1/chat/completions",
      "status": 401,
      "body": {
        "error": {
          "message": "Authentication Error, Invalid proxy server token passed",
          "type": "auth_error"
        }
      }
    }
  ],
  "expect": {
    "family": "unknown_compatible",
    "label": "compatible_unidentified",
    "protocols": {
      "chat": 401
    },
    "models": 1,
    "max_requests": 12,
    "requests": 5,
    "warnings": [],
    "model_info_requested": true
  }
}

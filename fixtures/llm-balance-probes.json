{
  "version": 1,
  "adapters": [
    {
      "id": "moonshot",
      "evidence": "documented",
      "verified_on": "2026-11-07",
      "match": {
        "preset_ids": [
          "moonshot"
        ],
        "host_suffixes": [
          "moonshot.cn",
          "moonshot.ai"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/v1/users/me/balance",
        "auth": "bearer"
      },
      "extract": {
        "scope": "account",
        "remaining": "$.data.available_balance",
        "unit": {
          "by_host": {
            "moonshot.cn": "CNY"
          }
        },
        "labels": [
          {
            "name": "voucher_balance",
            "path": "$.data.voucher_balance"
          },
          {
            "name": "cash_balance",
            "path": "$.data.cash_balance"
          }
        ]
      },
      "unverified_units": {
        "moonshot.ai": "USD"
      },
      "notes": "available_balance can be 0 while a voucher remains; the voucher is kept in the labels. .cn and .ai keys are not interchangeable. Only the documented .cn unit is applied; the .ai unit (USD) is an inference kept in unverified_units until it is verified on a live key, so .ai shows Unit unknown with the raw number.",
      "recorded": {
        "host": "api.moonshot.cn",
        "body": {
          "code": 0,
          "data": {
            "available_balance": 49.59,
            "voucher_balance": 46.59,
            "cash_balance": 3.0
          },
          "scode": "0x0",
          "status": true
        },
        "expect_remaining": 49.59,
        "expect_unit": "cny"
      }
    },
    {
      "id": "siliconflow",
      "evidence": "documented",
      "verified_on": "2026-11-07",
      "match": {
        "preset_ids": [
          "siliconflow"
        ],
        "host_suffixes": [
          "siliconflow.cn",
          "siliconflow.com"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/v1/user/info",
        "auth": "bearer"
      },
      "extract": {
        "scope": "account",
        "remaining": "$.data.totalBalance",
        "unit": {
          "by_host": {
            "siliconflow.cn": "CNY"
          }
        },
        "envelope": {
          "ok_path": "$.code",
          "ok_equals": 20000,
          "message_path": "$.message"
        },
        "labels": [
          {
            "name": "balance",
            "path": "$.data.balance"
          },
          {
            "name": "chargeBalance",
            "path": "$.data.chargeBalance"
          }
        ]
      },
      "unverified_units": {
        "siliconflow.com": "USD"
      },
      "notes": "Envelope code 20000 is success; totalBalance is a decimal string and includes granted credit. Only the documented .cn unit is applied; the .com unit (USD) is an inference kept in unverified_units until verified on a live key.",
      "recorded": {
        "host": "api.siliconflow.cn",
        "body": {
          "code": 20000,
          "message": "OK",
          "status": true,
          "data": {
            "id": "u-1",
            "name": "ann",
            "email": "a@b.c",
            "balance": "0.88",
            "status": "normal",
            "chargeBalance": "88.00",
            "totalBalance": "88.88"
          }
        },
        "expect_remaining": 88.88,
        "expect_unit": "cny"
      }
    },
